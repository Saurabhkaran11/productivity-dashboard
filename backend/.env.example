# MyLife Dashboard — backend environment variables
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# HMAC token signing secret — change to a long random string in production.
# Generate one with:  openssl rand -hex 32
APP_SECRET=change-me-in-production

# Restrict which email domains may register or connect Google?
# Leave blank to allow anyone, or set e.g.  ALLOWED_DOMAIN=your-company.com
ALLOWED_DOMAIN=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (set your real domain).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL the app is served from (used for Google OAuth redirect).
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Point at a PostgreSQL URL in production, e.g.
# DATABASE_URL=postgresql://mylifeapp:PASSWORD@mylife-db.abcdefg.us-east-1.rds.amazonaws.com:5432/mylife
# When left blank, the app uses a local SQLite file at ./data.db (dev only).
DATABASE_URL=

# When using SQLite (dev), path to the file:
MYLIFE_DB=./data.db

# When serving the built frontend from the backend (production image), the
# path to the built React app inside the container:
FRONTEND_DIST=../frontend/dist

# ---------------------------------------------------------------------------
# Google OAuth (optional — enables Google login, Sheets export, Drive backup,
# the My Google data page, and Gmail reports)
# ---------------------------------------------------------------------------
# See README "Enable Google login + Drive/Sheets/Gmail" and the AWS steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Run scheduled tasks (daily email, etc.). Off when set to anything falsy
# like "false" / "0" / "" — useful for a stateless multi-task setup.
ENABLE_SCHEDULER=true
